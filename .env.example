# ==============================================================================
# 墨枢 · InkVerse (By Timskt) — Docker Compose 环境变量模板 (.env.example)
# 复制为 .env 即可自定义宿主机映射端口与日志级别：cp .env.example .env
# ==============================================================================

# 前端 Web 工作台宿主机端口 (默认 http://localhost:3000)
FRONTEND_PORT=3000

# Rust 2.0 核心后端宿主机端口 (默认 http://localhost:8000)
BACKEND_PORT=8000

# Rust 后端日志级别
RUST_LOG=nov_server=info,tower_http=info

# [可选 Profile: full / mcp] Python MCP 网关宿主机端口
MCP_PORT=8001

# [可选 Profile: full] PostgreSQL pgvector 配置
POSTGRES_PORT=5432
POSTGRES_USER=novadmin
POSTGRES_PASSWORD=novpassword123
POSTGRES_DB=novmanager
